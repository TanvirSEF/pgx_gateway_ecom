# Database (PostgreSQL URL for remote or local database)
DATABASE_URL=postgresql://postgres:password@host:5432/postgres?schema=public
DIRECT_URL=postgresql://postgres:password@host:5432/postgres?schema=public

# JWT Security
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"

# App & Networking
PORT=4000
NODE_ENV=production
# Frontend URL(s) for CORS (can be comma-separated or wildcard e.g. https://playgroundfitnex.com,https://api.playgroundfitnex.com)
FRONTEND_URL=https://playgroundfitnex.com

# Mail Configuration
# SECURITY NOTE (2026-10-29): this file previously had a real-looking
# Gmail address + 16-char app-password sitting here as if they were
# placeholders - redacted before this file was ever included in a client
# delivery. If that value was ever real, rotate it in the Google account
# that owned it; never restore a real value into an ".example" file.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
MAIL_FROM="PGX Fitness <info@playgroundfitnex.com>"

# Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your_supabase.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ewhufhufwuhf....
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciO...

STRIPE_SECRET_KEY=sk_test_8ILJQja...
STRIPE_WEBHOOK_SECRET=whsec_yZnBbN...
STRIPE_CURRENCY=eur

# Phase 2 - PGXSports Shared Wallet Integration
# Central Wallet Service client (PGX Casino, pgx_frontend_api_node /internal/wallet/*)
# Shared-wallet currency is EUR (corrected 2026-10-29 - matches PGX Casino's
# actual player/account currency and this app's own STRIPE_CURRENCY above;
# Phase 1's Central Wallet Service rejects any other currency - see
# wallet-service-client.service.ts's SUPPORTED_CURRENCIES).
WALLET_SERVICE_BASE_URL=https://staging.pgxcasino.com/api
WALLET_SERVICE_API_KEY=
WALLET_SERVICE_SOURCE=pgxsports-stripe
WALLET_SERVICE_TIMEOUT_MS=10000

# Secure payment handoff (PGX Casino -> PGXSports) - dedicated secret, never
# reused from JWT_SECRET. Must match whatever PGX Casino's issuer signs with.
CASINO_HANDOFF_SECRET=
# Comma-separated allowlist of returnUrl values a handoff token may carry.
CASINO_HANDOFF_RETURN_URL_ALLOWLIST=

# Dedicated Stripe credentials for the shared-wallet top-up ONLY - deliberately
# SEPARATE from both STRIPE_SECRET_KEY/STRIPE_WEBHOOK_SECRET above (this app's
# own e-commerce Stripe account, which must NOT be used to fund a casino
# wallet - see casino-topup-stripe.config.ts's header comment) and from PGX
# Casino's own Stripe.js integration. Fails closed (feature stays inert) until
# BOTH are set to a real, approved value.
CASINO_TOPUP_STRIPE_SECRET_KEY=
CASINO_TOPUP_STRIPE_WEBHOOK_SECRET=

# Phase 4 - service-to-service credential for GET /casino-topup/status/:topupId
# (PGX Casino's backend is the ONLY caller). Must match the identical value
# configured on the Casino side - see casino-topup-status.guard.ts.
CASINO_TOPUP_STATUS_API_KEY=

# New MongoDB top-up collection (wallet_topups) - same deployment as PGX
# Casino's walletLedger, per the shared-wallet architecture doc.
WALLET_MONGODB_URI=
WALLET_MONGODB_DB=pgx_wallet

# Legacy Supabase EUR top-up path (wallet.controller.ts POST /wallet/topup +
# webhook.service.ts's wallet-topup credit branch). Defaults OFF in Phase 2
# to prevent a second, disconnected wallet balance - see wallet.service.ts.
WALLET_LEGACY_TOPUP_ENABLED=false